# ==========================================
# HeartGuard FYP - Git Ignore Rules
# ==========================================

# --- Environment Variables & Secrets ---
.env
Backend/.env
!.env.example
!Backend/.env.example

# --- Python ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
Backend/venv/
Backend/.venv/
Backend/env/

# --- Node / Frontend ---
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- Operating System & IDEs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
